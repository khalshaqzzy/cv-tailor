{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khalshaqzzy/cv-tailor/schemas/tailored-cv.schema.json",
  "title": "CV Tailor Tailored CV",
  "type": "object",
  "required": ["candidate", "job", "metadata", "sections"],
  "properties": {
    "candidate": {
      "type": "object",
      "required": ["name", "email"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 3 },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "linkedin": { "type": "string" },
        "github": { "type": "string" },
        "portfolio": { "type": "string" }
      },
      "additionalProperties": true
    },
    "job": {
      "type": "object",
      "required": ["company", "role"],
      "properties": {
        "company": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "required": ["approvedByUser", "paperFormat"],
      "properties": {
        "approvedByUser": { "type": "boolean" },
        "paperFormat": { "type": "string", "enum": ["a4", "letter"] },
        "language": { "type": "string", "default": "en" },
        "generatedAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "object",
      "required": ["summary", "competencies", "experience", "skills"],
      "properties": {
        "summary": {
          "type": "object",
          "required": ["text", "sourceIds"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "sourceIds": { "$ref": "#/$defs/sourceIds" }
          },
          "additionalProperties": true
        },
        "competencies": { "type": "array", "items": { "type": "string" } },
        "experience": { "type": "array", "items": { "$ref": "#/$defs/position" } },
        "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
        "education": { "type": "array", "items": { "$ref": "#/$defs/simpleItem" } },
        "certifications": { "type": "array", "items": { "$ref": "#/$defs/simpleItem" } },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/skillGroup" } }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "bullet": {
      "type": "object",
      "required": ["text", "sourceIds"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      },
      "additionalProperties": true
    },
    "position": {
      "type": "object",
      "required": ["company", "role", "bullets"],
      "properties": {
        "company": { "type": "string" },
        "role": { "type": "string" },
        "period": { "type": "string" },
        "location": { "type": "string" },
        "bullets": { "type": "array", "items": { "$ref": "#/$defs/bullet" } }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["name", "description", "sourceIds"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "tech": { "type": "string" },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      },
      "additionalProperties": true
    },
    "simpleItem": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "period": { "type": "string" },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      },
      "additionalProperties": true
    },
    "skillGroup": {
      "type": "object",
      "required": ["category", "items"],
      "properties": {
        "category": { "type": "string" },
        "items": { "type": "array", "items": { "type": "string" } },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
